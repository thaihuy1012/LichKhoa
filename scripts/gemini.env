# Model theo làn — sửa file này khi 'agy models' đổi tên. Ghi tên gốc + effort riêng (trong agy, effort là thanh chọn riêng); tên đã kèm -high/-medium/-low cũng được.
# Menu /model của agy (chữ "current", mức effort đang chọn) chỉ áp dụng khi bạn gõ tay trong agy; pipeline chạy theo file này cho từng làn.
# v5.2 (10/11/2026): Flash (hạn mức dồi dào) làm mọi việc nhiều lượt gọi; Argon (hạn mức riêng: cửa sổ 5 giờ + trần tuần) chỉ cho việc ít lượt gọi mà giá trị cao.
GEMINI_CODE=gemini-3.8-flash;   EFFORT_CODE=high     # thợ code vòng 1–3 (kể cả T-1.1, T-n.END, bug S3/S4); cũng là model chạy thay khi Argon nghỉ
GEMINI_KHO=gemini-4-argon;      EFFORT_KHO=medium    # vòng 4 nâng bậc (agy-run.sh code <prompt> kho): phiếu agentic tốn nhiều lượt gọi nhất → medium
GEMINI_SOAT=gemini-4-argon;     EFFORT_SOAT=high     # soát chéo milestone: 4 lượt/dự án, chốt chặn chất lượng, góc nhìn khác Claude
GEMINI_DOC=gemini-3.8-flash;    EFFORT_DOC=high      # đọc rộng / khảo sát: nhiều lượt gọi, ngữ cảnh 1M+, không cần suy luận sâu
GEMINI_SINH=gemini-3.8-flash;   EFFORT_SINH=low      # sinh file cơ học
GEMINI_YTUONG=gemini-4-argon;   EFFORT_YTUONG=high   # cùng Kiến trúc sư (Fable 5.1 max) lên ý tưởng: 1–2 lượt/dự án, quyết định hướng đi
MODEL_VONG5=claude-sonnet-5-5;  EFFORT_VONG5=medium  # vòng 5 (agy-run.sh code <prompt> vong5): Claude Sonnet QUA agy — trừ hạn mức Claude của gói Google, không tốn token Claude Code; bật/tắt ở docs/TASKS.md
# Không dùng: Claude Opus 5.5 trong agy (~10–25 lượt/5 giờ, một phiếu agentic dễ ăn hết). GPT-OSS 120B chỉ là dự phòng tay khi Flash cũng bị khóa (xem docs/LAN-GEMINI.md mục 1).
AGY_FORMAT=text
