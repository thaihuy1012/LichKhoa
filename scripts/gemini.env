# Model Gemini theo làn — sửa file này khi 'agy models' đổi tên. Slug có hoặc không kèm -high/-medium/-low đều được.
GEMINI_CODE=gemini-3.8-flash; EFFORT_CODE=high     # viết code
GEMINI_SOAT=gemini-3.1-pro;   EFFORT_SOAT=high     # soát chéo (model khác model viết code)
GEMINI_DOC=gemini-3.1-pro;    EFFORT_DOC=high      # đọc rộng
GEMINI_SINH=gemini-3.8-flash; EFFORT_SINH=low      # sinh file cơ học
