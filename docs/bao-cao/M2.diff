+        </button>
+        <div class="cal-title">
+          {t(`month.${ym.m0}`, lang)} {ym.y}
+        </div>
+        <button type="button" data-testid="cal-next" onClick={() => gotoMonth(1)} aria-label={t('events.nextMonth', lang)}>
+          ›
+        </button>
+      </div>
+      <div class="cal-weekdays">
+        {weekdayOrder.map((dow) => (
+          <div key={dow} class="cal-wd">
