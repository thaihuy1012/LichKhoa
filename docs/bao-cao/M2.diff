+  const scale = unscaledBoxHeight > usable ? usable / unscaledBoxHeight : 1;
+
+  const boxHeight = unscaledBoxHeight * scale;
+  const sPadding = padding * scale;
+  const sLabelSize = labelSize * scale;
+  const sLineSize = lineSize * scale;
