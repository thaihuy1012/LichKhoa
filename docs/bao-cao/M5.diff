+# ---------- tổng kết ----------
+ket_qua() {
+  local name=$1 st="$OUT/$1.status" out="$OUT/$1.md" err="$OUT/$1.err" state code secs mode model pf cls
+  [ -f "$st" ] || die 42 "Không có lượt tên $name."
+  sua_status_chet "$st"
+  read -r state code secs < "$st"
