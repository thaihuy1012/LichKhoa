+# ---------- đợi ----------
+cho() {
+  local name=$1 wait=${2:-100} st="$OUT/$1.status" state a b t0 now limit
+  [ -f "$st" ] || die 42 "Không có lượt tên $name."
+  limit=$(sed -n 's/^mode=//p' "$OUT/$name.meta" 2>/dev/null); limit=${LIMIT[${limit:-code}]:-30}
+  t0=$(date +%s)
