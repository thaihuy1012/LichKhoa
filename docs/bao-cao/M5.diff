+# ---------- danh sách file được phép trong prompt ----------
+file_duoc_phep() {
+  awk '
+    /^## / { inlist = 0 }
+    inlist && /^- / { sub(/^- +/, ""); gsub(/`/, ""); gsub(/^[ \t]+|[ \t]+$/, ""); if ($0 != "") print }
+    tolower($0) ~ /^## .*file được phép/ { inlist = 1 }
+  ' "$1"
+}
+duoc_phep() {  # $1=path  $2..=entries
+  local p=$1 e; shift
+  for e in "$@"; do
+    case "$e" in
+      */) [[ "$p" == "$e"* ]] && return 0 ;;
+      *)  [ "$p" = "$e" ] && return 0 ;;
+    esac
+  done
+  return 1
+}
