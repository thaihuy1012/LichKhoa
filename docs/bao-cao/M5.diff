+  if [ "$state" = "RUNNING" ]; then
+    kill_tree "$a"
+    command -v taskkill >/dev/null 2>&1 && taskkill //F //IM agy.exe >/dev/null 2>&1
+    sleep 1
+    echo "DONE 130 $(( $(date +%s) - b ))" > "$st"
+  fi
+  hoan_tac_tat_ca
+  echo "ĐÃ HỦY: $name — mọi thay đổi trong cây làm việc đã hoàn tác."
+}
