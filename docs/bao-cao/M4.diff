-  return (v as Blob) ?? null;
+  if (v == null) return null;
+  if (v instanceof Blob) return v; // tương thích ngược nếu từng lưu trực tiếp
+  if (isStoredBg(v)) return new Blob([v.buf], { type: v.type });
+  return null;
